  },
  {
   "name": "Blot",
   "group": "Transitions",
   "height": 320,
   "preview": "project/components/Blot/preview.html",
   "readme": "project/components/Blot/README.md",
   "summary": "An ink blot opens from the middle of an element to reveal it: for a new look, a found thing, the first picture of a chapter."
  },
  {
   "name": "Fold",
   "group": "Transitions",
   "height": 290,
   "preview": "project/components/Fold/preview.html",
   "readme": "project/components/Fold/README.md",
   "summary": "A view folds away like paper to show the next one underneath: the top half folds down over the bottom, then the folded sheet drops away."
  },
  {
   "name": "Brook",
   "group": "Play",
   "height": 410,
   "preview": "project/components/Brook/preview.html",
   "readme": "project/components/Brook/README.md",
   "summary": "The map of a game: a meandering watercolor brook with stepping stones that are scenes, chapters or mini-games."
  },
  {
   "name": "Creature",
   "group": "Play",
   "height": 380,
   "preview": "project/components/Creature/preview.html",
   "readme": "project/components/Creature/README.md",
   "summary": "Saelion: a bunny, a tree octopus and a butterfly pixie at once, which grows from an egg."
  },
  {
   "name": "Button",
   "group": "Actions",
   "height": 190,
   "preview": "project/components/Button/preview.html",
   "readme": "project/components/Button/README.md",
   "summary": "Pill-shaped actions in the interface face; one primary per view, in `accent`."
  },
  {
   "name": "Seal",
   "group": "Actions",
   "height": 170,
   "preview": "project/components/Seal/preview.html",
   "readme": "project/components/Seal/README.md",
   "summary": "A wax seal in `accent` for the one press that begins or keeps something: begin the book, sign it, keep this."
  },
  {
   "name": "Chip",
   "group": "Shelf",
   "height": 90,
   "preview": "project/components/Chip/preview.html",
   "readme": "project/components/Chip/README.md",
   "summary": "A small tag with a dot and a word, in one of five categorical colors: what kind of game, how long, what it needs."
  },
  {
   "name": "Shelf",
   "group": "Shelf",
   "height": 450,
   "preview": "project/components/Shelf/preview.html",
   "readme": "project/components/Shelf/README.md",
   "summary": "The 99\u00a2 Shelf: game covers standing on a copper board, scrolling sideways, each with a price tag on a string."
  },
  {
   "name": "Choice",
   "group": "Inputs",
   "height": 230,
   "preview": "project/components/Choice/preview.html",
   "readme": "project/components/Choice/README.md",
   "summary": "A row of pill-shaped radio choices for picking one of a few: who reads, the pace, how hard."
  },
  {
   "name": "Looks",
   "group": "Inputs",
   "height": 340,
   "preview": "project/components/Looks/preview.html",
   "readme": "project/components/Looks/README.md",
   "summary": "The look picker: one button per look, each showing that look's paper, two of its pigments and its display face."
  },
  {
   "name": "Slider",
   "group": "Inputs",
   "height": 130,
   "preview": "project/components/Slider/preview.html",
   "readme": "project/components/Slider/README.md",
   "summary": "A range on a copper thread with an `accent` bead, for one continuous setting: reading speed, space, volume."
  },
  {
   "name": "Toggle",
   "group": "Inputs",
   "height": 110,
   "preview": "project/components/Toggle/preview.html",
   "readme": "project/components/Toggle/README.md",
   "summary": "An on/off switch: a folded-paper tab sliding in a track."
  },
  {
   "name": "Dialog",
   "group": "Overlays",
   "height": 310,
   "preview": "project/components/Dialog/preview.html",
   "readme": "project/components/Dialog/README.md",
   "summary": "A sheet that asks one question over a veiled page: a title in the display face, a sentence or two in the story face, and two buttons."
  },
  {
   "name": "Drawer",
   "group": "Overlays",
   "height": 350,
   "preview": "project/components/Drawer/preview.html",
   "readme": "project/components/Drawer/README.md",
   "summary": "A side sheet from the right for a book's contents, settings or the album."
  },
  {
   "name": "Toast",
   "group": "Overlays",
   "height": 160,
   "preview": "project/components/Toast/preview.html",
   "readme": "project/components/Toast/README.md",
