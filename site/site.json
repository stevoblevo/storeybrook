  },
  {
   "name": "Jar",
   "group": "Rewards",
   "height": 150,
   "preview": "project/components/Jar/preview.html",
   "readme": "project/components/Jar/README.md",
   "summary": "The nougat jar: the count of every nougat a person has earned, filling toward a cap."
  },
  {
   "name": "Lock",
   "group": "Rewards",
   "height": 340,
   "preview": "project/components/Lock/preview.html",
   "readme": "project/components/Lock/README.md",
   "summary": "A striped cover over something that is not open yet."
  },
  {
   "name": "Sticker",
   "group": "Rewards",
   "height": 220,
   "preview": "project/components/Sticker/preview.html",
   "readme": "project/components/Sticker/README.md",
   "summary": "Stickers for things found and places opened, kept in an album."
  },
  {
   "name": "Page",
   "group": "Paper",
   "height": 350,
   "preview": "project/components/Page/preview.html",
   "readme": "project/components/Page/README.md",
