  },
  {
   "name": "Panels",
   "group": "Story",
   "height": 250,
   "preview": "project/components/Panels/preview.html",
   "readme": "project/components/Panels/README.md",
   "summary": "Comic panels: a grid of inked frames with captions, halftone and sound effects."
  },
  {
   "name": "Prose",
   "group": "Story",
   "height": 290,
   "preview": "project/components/Prose/preview.html",
   "readme": "project/components/Prose/README.md",
   "summary": "Story text and its marks: the lede, the body at the reading measure, a drop cap, ink links and the owner's handwritten note."
  },
  {
   "name": "Reader",
   "group": "Story",
   "height": 240,
   "preview": "project/components/Reader/preview.html",
   "readme": "project/components/Reader/README.md",
