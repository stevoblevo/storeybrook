  },
  {
   "name": "Sheet",
   "group": "Paper",
   "height": 230,
   "preview": "project/components/Sheet/preview.html",
   "readme": "project/components/Sheet/README.md",
   "summary": "A sheet of `page` laid on the paper: a deckled edge, the paper's grain, `shadow-page`, held down with washi tape at up to two corners."
  },
  {
   "name": "Spread",
   "group": "Paper",
   "height": 230,
   "preview": "project/components/Spread/preview.html",
   "readme": "project/components/Spread/README.md",
